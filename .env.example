# Copiar a `.env` y ajustar. NINGÚN valor real va en el repo.
# Generar una clave: python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=cambiame
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=America/Argentina/Buenos_Aires

# Base de datos (la usa el contenedor `db` y también Django en `web`)
MYSQL_DATABASE=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=chatbot
MYSQL_ROOT_PASSWORD=root
DB_HOST=db
DB_PORT=3306

# Puertos publicados al host (opcional)
WEB_PORT=8000
DB_PORT_PUBLISH=3306
